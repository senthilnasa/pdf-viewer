# ---------------------------------------------------------------
# PDF Viewer Platform — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ---------------------------------------------------------------

# Application
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database
DB_NAME=pdf_viewer
DB_USER=pdfviewer
DB_PASS=changeme_strong_password
DB_ROOT_PASS=changeme_root_password
DB_PORT_EXPOSE=3306

# Email / SMTP Configuration
SMTP_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_ENCRYPTION=tls
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=PDF Viewer

# Storage Configuration
STORAGE_DRIVER=local
# AWS S3 (optional)
# S3_KEY=your_key
# S3_SECRET=your_secret
# S3_BUCKET=your_bucket
# S3_REGION=us-east-1

# Cloudflare R2 (optional)
# CLOUDFLARE_R2_TOKEN=your_token
# CLOUDFLARE_R2_BUCKET=your_bucket
# CLOUDFLARE_R2_DOMAIN=your_domain.com

# phpMyAdmin (optional, only used with --profile tools)
PMA_PORT=8081
